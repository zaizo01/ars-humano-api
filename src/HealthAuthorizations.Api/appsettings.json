{
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Coverage": {
    "CoveragePercentage": 70
  },
  "Jwt": {
    "Issuer": "health-authorizations-api",
    "Audience": "health-authorizations-clients",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Outbox": {
    "PollingInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "RabbitMq": {
    "Enabled": false,
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "Exchange": "health-authorizations.events"
  },
  "MediatR": {
    "LicenseKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
